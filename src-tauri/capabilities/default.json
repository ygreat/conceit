{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-theme",
    "dialog:allow-save",
    "fs:allow-write-file",
    "dialog:allow-open",
    "core:window:allow-set-title",
    "opener:allow-reveal-item-in-dir"
  ]
}
